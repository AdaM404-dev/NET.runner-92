#!/usr/bin/env bash
# Headless player build of the scenes enabled in Build Settings.
# Usage: bin/unity-build [linux|windows]   (default: linux)
# Output: Builds/Linux/NET.runner-92.x86_64 or Builds/Windows/NET.runner-92.exe
# Full log: Logs/cli-build-<target>.log
set -uo pipefail
source "$(dirname "$0")/_unity.sh"

target="${1:-linux}"
case "$target" in
  linux)   out="$PROJECT_ROOT/Builds/Linux/NET.runner-92.x86_64"; args=(-buildTarget Linux64 -buildLinux64Player "$out") ;;
  windows) out="$PROJECT_ROOT/Builds/Windows/NET.runner-92.exe";  args=(-buildTarget Win64 -buildWindows64Player "$out") ;;
  *) echo "usage: bin/unity-build [linux|windows]" >&2; exit 2 ;;
esac
mkdir -p "$(dirname "$out")"

# No -nographics: HDRP needs a graphics device to set up its resources.
status=0
run_unity "build-$target" -quit "${args[@]}" || status=$?

errors="$(print_compile_errors)"
[[ -n "$errors" ]] && echo "$errors"
if [[ $status -ne 0 || ! -f "$out" ]]; then
  echo "FAILED: build did not complete (Unity exit $status). See $UNITY_LOG"
  exit 1
fi
echo "OK: $out"
