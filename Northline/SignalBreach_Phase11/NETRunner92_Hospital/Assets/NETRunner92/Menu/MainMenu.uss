.net-menu {
    --ink: #071018;
    --paper: #f1f8fc;
    --muted: #aabdc8;
    --cyan: #66f6e4;
    --line: rgba(163, 217, 225, .32);
    color: var(--paper);
    -unity-font: url("../UI/RobotoMono-Regular.ttf");
    font-size: 18px;
}
.plate, .backdrop-gradient, .dust, .dialog-scrim, .pause-overlay, .fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.plate {
    left: -32px; right: -32px; top: -20px; bottom: -20px;
    background-size: cover; background-position: center;
    -unity-background-image-tint-color: rgb(155, 179, 192);
}
.topline, .bottomline {
    position: absolute; left: 4.5%; right: 4.5%; height: 55px;
    flex-direction: row; align-items: center; justify-content: space-between;
    border-color: var(--line);
}
.topline { top: 34px; border-bottom-width: 1px; }
.bottomline { bottom: 27px; border-top-width: 1px; }
.eyebrow { color: var(--cyan); font-size: 15px; letter-spacing: 2px; margin: 0; }
.metadata { color: var(--muted); font-size: 15px; letter-spacing: 1px; margin: 0; }
.home { position: absolute; top: 15.5%; left: 7%; max-width: 80%; }
.wordmark { flex-direction: row; align-items: flex-end; margin-top: 10px; }
.logo { margin: 0; padding: 0; font-size: 92px; letter-spacing: -6px; -unity-font-style: bold; }
.logo-index { margin: 0 0 13px 9px; color: var(--cyan); font-size: 55px; letter-spacing: -3px; }
.subtitle { margin: 3px 0 30px 3px; font-size: 20px; letter-spacing: 4px; color: var(--muted); }
.main-actions { width: 450px; max-width: 100%; }
.menu-button {
    margin: 0; min-height: 44px; padding: 6px 16px;
    background-color: rgba(7, 16, 24, .88); color: var(--paper); border-radius: 0;
    border-width: 1px; border-color: var(--line);
    transition-property: background-color, border-color, color; transition-duration: .15s;
}
.menu-button:hover, .menu-button:focus { color: var(--cyan); background-color: #16313a; border-color: var(--cyan); }
.menu-button:disabled { color: #708590; opacity: .55; }
.home-button {
    min-height: 62px; margin-bottom: 8px; padding: 0 16px;
    flex-direction: row; align-items: center;
    border-left-width: 3px;
    background-color: rgba(7, 16, 24, .81);
}
.button-index { color: var(--cyan); width: 49px; font-size: 14px; letter-spacing: 1.5px; }
.button-title { flex-grow: 1; font-size: 23px; color: var(--paper); }
.button-indicator { color: var(--cyan); font-size: 25px; opacity: .45; translate: -7px 0;
    transition-property: translate, opacity; transition-duration: .15s; }
.home-button:hover .button-indicator, .home-button:focus .button-indicator { translate: 0 0; opacity: 1; }

.drawer {
    position: absolute; top: 12%; bottom: 12%; left: 7%; width: 1220px; max-width: 86%;
    transition-property: opacity, translate; transition-duration: .18s;
    background-color: rgba(6, 14, 22, .96); border-width: 1px; border-top-width: 3px; border-color: var(--line);
}
.drawer-entering { opacity: 0; translate: -8px 0; }
.drawer-heading { padding: 22px 27px; flex-direction: row; align-items: center; justify-content: space-between;
    border-bottom-width: 1px; border-color: var(--line); }
.drawer-title { margin: 7px 0 0; font-size: 36px; -unity-font-style: bold; }
.drawer-body { flex-grow: 1; flex-basis: 0; min-height: 0; }
.settings-layout { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.settings-tabs { width: 245px; padding: 20px 14px; border-right-width: 1px; border-color: var(--line); }
.settings-tabs .menu-button { margin: 0 0 7px; -unity-text-align: middle-left; }
.settings-tabs .selected-tab { border-left-width: 3px; border-left-color: var(--cyan); color: var(--cyan); background-color: #112730; }
.settings-rows { flex-grow: 1; flex-basis: 0; padding: 11px 24px; }
.setting-section { margin: 12px 0 7px; color: var(--cyan); font-size: 14px; letter-spacing: 1.8px; }
.setting-row {
    flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0;
    min-height: 49px; padding: 5px 0;
    border-bottom-width: 1px; border-color: rgba(159, 187, 201, .17);
}
.setting-label { flex-grow: 1; flex-basis: 0; font-size: 17px; white-space: normal; }
.setting-choice, .setting-range { width: 38%; min-width: 130px; margin: 0; }
.setting-range { flex-direction: row; align-items: center; }
.setting-range Slider { flex-grow: 1; }
.setting-value { width: 88px; -unity-text-align: middle-right; color: var(--cyan); font-size: 15px; }
.setting-toggle { margin: 0 9px 0 0; min-height: 31px; }
.setting-toggle .unity-toggle__checkmark { background-color: #152a34; border-width: 1px; border-color: var(--line); }
.setting-toggle:focus .unity-toggle__checkmark { border-color: var(--cyan); }
.setting-choice .unity-base-popup-field__input {
    min-height: 34px; background-color: #11242e; border-radius: 0; border-color: var(--line); color: var(--paper);
}
.setting-choice:focus .unity-base-popup-field__input { border-color: var(--cyan); }
.setting-choice .unity-base-popup-field__text { color: var(--paper); font-size: 16px; }
.unity-base-slider__tracker { background-color: #28444f; }
.unity-base-slider__dragger { background-color: var(--cyan); }
.setting-note { color: var(--muted); font-size: 15px; white-space: normal; margin: 13px 0; }
.settings-footer {
    flex-direction: row; justify-content: flex-end; padding: 12px 22px;
    border-top-width: 1px; border-color: var(--line);
}
.settings-footer .menu-button, .dialog-actions .menu-button, .slot-actions .menu-button { margin-left: 8px; }
.menu-button.primary { color: #061720; background-color: var(--cyan); border-color: var(--cyan); }
.menu-button.primary:hover, .menu-button.primary:focus { background-color: #c0fff6; border-color: white; }
.slot-list { flex-grow: 1; padding: 12px 23px; }
.slot {
    padding: 15px 9px; flex-direction: row; justify-content: space-between; align-items: center;
    border-bottom-width: 1px; border-color: var(--line);
}
.slot-copy { flex-grow: 1; flex-basis: 0; }
.slot-title { font-size: 24px; margin: 4px 0; white-space: normal; }
.slot .metadata { white-space: normal; }
.slot-actions { flex-direction: row; }
.dialog-scrim, .pause-overlay {
    align-items: center; justify-content: center;
    background-color: rgba(4, 8, 12, .75);
}
.dialog-card {
    width: 650px; max-width: 88%; padding: 26px 28px;
    background-color: #0a151e; border-top-width: 3px; border-bottom-width: 1px; border-color: var(--cyan);
}
.dialog-title { font-size: 28px; margin: 9px 0; white-space: normal; }
.dialog-copy { color: var(--muted); margin: 4px 0 16px; white-space: normal; }
.dialog-actions { flex-direction: row; justify-content: flex-end; margin-top: 7px; }
.pause-card .menu-button { margin: 6px 0 0; }
.toast {
    position: absolute; bottom: 105px; right: 4.5%; max-width: 65%; white-space: normal;
    color: var(--paper); padding: 12px 20px; background-color: #0d222b; border-left-width: 3px; border-left-color: var(--cyan);
    opacity: 0; transition-property: opacity; transition-duration: .15s;
}
.toast.shown { opacity: 1; }
.fade { background-color: #030609; opacity: 1; transition-property: opacity; transition-duration: .42s; }
.fade.transparent { opacity: 0; }
.contrast { --paper: #ffffff; --muted: #eff8ff; --cyan: #90fff3; --line: #d6eafa; }
.contrast .drawer, .contrast .dialog-card, .contrast .menu-button { background-color: #000b12; }
.contrast .menu-button.primary { background-color: var(--cyan); }
.static-motion .fade, .static-motion .drawer, .static-motion .menu-button, .static-motion .button-indicator { transition-duration: 0s; }
